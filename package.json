{
  "name": "one-to-all",
  "version": "1.0.0",
  "description": "Unified AI Models Integration Platform - All AI models at one place",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "type-check": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "ai",
    "llm",
    "gpt",
    "claude",
    "gemini",
    "openai",
    "anthropic",
    "google",
    "unified-api",
    "multi-provider"
  ],
  "author": "abidjan527-jpg",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.5",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.1.2",
    "express-async-errors": "^3.1.1",
    "winston": "^3.11.0",
    "redis": "^4.6.11",
    "ioredis": "^5.3.2",
    "openai": "^4.20.1",
    "@google-cloud/vertexai": "^0.5.0",
    "@anthropic-ai/sdk": "^0.9.2",
    "cohere-ai": "^7.8.0",
    "@replicate/replicate": "^0.33.1",
    "express-rate-limit": "^7.1.5",
    "prom-client": "^15.0.0",
    "uuid": "^9.0.1",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.8",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/redis": "^4.0.11",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12"
  }
}
