{
  "name": "one-to-all",
  "version": "1.1.0",
  "private": true,
  "description": "AI ONE-TO-ALL multi-model comparison PWA and Android app",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check",
    "mobile:configure": "node scripts/configure-api.mjs",
    "android:add": "npx cap add android",
    "android:assets": "node scripts/generate-android-assets.mjs",
    "mobile:sync": "npm run build && npx cap sync",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npm run android:sync && npx cap open android",
    "android:run": "npm run android:sync && npx cap run android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew assembleRelease bundleRelease"
  },
  "keywords": [
    "ai",
    "llm",
    "multi-model",
    "pwa",
    "android"
  ],
  "author": "abidjan527-jpg",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "uuid": "^11.0.5",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.9",
    "sharp": "^0.35.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
